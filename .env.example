# ============================================================
# 保存・ダッシュボード・削除を使うには以下 3 つが必須です。
# Vercel の場合は Project → Settings → Environment Variables に設定してください。
# ============================================================
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
D2C_OWNER_ID="00000000-0000-0000-0000-000000000001"

# 未設定の場合は「デモモード」になり、生成結果は保存されずダッシュボードには出ません。

# Vercel など本番: Regenerate 後のリダイレクト先（例: https://your-app.vercel.app）
# 未設定時は localhost:3000 を使用します。
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
