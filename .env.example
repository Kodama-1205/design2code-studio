# ============================================================
# 保存・ダッシュボード・削除・ログインを使うには以下が必須です。
# Vercel: Project → Settings → Environment Variables に設定してください。
# ============================================================
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
D2C_OWNER_ID="00000000-0000-0000-0000-000000000001"

# 推奨（本番では必ず設定）
# D2C_ENCRYPTION_KEY="32文字以上の任意の秘密文字列"

# 未設定の場合は「デモモード」になり、生成結果は保存されずダッシュボードには出ません。

# Vercel 本番: Regenerate 後のリダイレクト先
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# 任意: Figma プレビュー画像取得（/api/figma-preview および生成時の保存用）
# FIGMA_ACCESS_TOKEN=""
